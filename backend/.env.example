APP_APP_NAME=AI Excel Assistant
APP_APP_VERSION=1.0.0
# development (default): /docs, /redoc, /openapi.json enabled. production: they are disabled.
APP_APP_ENV=development

# Logging
APP_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Agent loop
MAX_STEPS=5

# Conversational memory — recent entries sent verbatim; oversized tool payloads
# are digested before storage or inclusion in an LLM prompt.
MEMORY_WINDOW_TURNS=12
MEMORY_MAX_DATA_CHARS=2000

# Repository layer — SQLite busy-timeout in seconds for each DB call
TOOL_TIMEOUT_SECONDS=5

# LLM provider selection (generic vars select the active provider/model;
# the API key is provider-specific so multiple providers can be configured
# side by side without colliding).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Example of adding another provider later (not implemented yet):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-...
# ANTHROPIC_API_KEY=
